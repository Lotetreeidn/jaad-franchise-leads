{
  // Cloudflare Workers free plan: one Worker + D1 + static assets + cron.
  "name": "jaad-franchise-leads",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/apply", "/apply/*"] },
  "d1_databases": [
    // Replace database_id with the id printed by `npx wrangler d1 create jaad-franchise`.
    { "binding": "DB", "database_name": "jaad-franchise", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // 02:15 and 10:15 UTC = 09:15 and 17:15 WIB. Jobs do nothing until enabled in Settings.
  "triggers": { "crons": ["15 2 * * *", "15 10 * * *"] },
  "vars": { "APP_NAME": "JAAD Franchise Leads", "OVERPASS_URL": "https://overpass-api.de/api/interpreter" }
}
